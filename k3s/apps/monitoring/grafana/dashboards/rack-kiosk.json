{
  "uid": "rack-kiosk",
  "title": "Rack Kiosk",
  "tags": [
    "homelab",
    "kiosk"
  ],
  "schemaVersion": 39,
  "editable": true,
  "style": "dark",
  "refresh": "1m",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "hidden": true
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "description": "Sized for the DeskPi 7.84\" rack panel (1280x400). A three-unit stat strip over three seven-unit bar gauges is the entire ten-row budget, so keep additions swaps rather than appends. Read at arm's length: no legends, no axes, thresholds do the talking. The gauges share a host order, so a struggling host reads as a vertical streak across all three.",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "CLUSTER CPU",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\",node=~\"k3s.*\"}[5m])))",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "text": {
          "titleSize": 12,
          "valueSize": 40
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "CLUSTER MEM",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "expr": "100 * (1 - sum(node_memory_MemAvailable_bytes{node=~\"k3s.*\"}) / sum(node_memory_MemTotal_bytes{node=~\"k3s.*\"}))",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "text": {
          "titleSize": 12,
          "valueSize": 40
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
