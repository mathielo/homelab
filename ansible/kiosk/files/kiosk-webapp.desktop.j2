[Desktop Entry]
# Managed by ansible/kiosk.yaml — do not edit on the node.
# Epiphany looks this up through the desktop portal to confirm the profile is a
# real web app. Without it --application-mode degrades to a normal browser
# window, address bar and all.
Type=Application
Name=Rack Kiosk
Exec=/usr/bin/epiphany --application-mode --profile={{ kiosk_profile_dir }} "{{ kiosk_url }}"
StartupWMClass={{ kiosk_app_id }}
StartupNotify=true
Terminal=false
NoDisplay=true
Categories=Network;WebBrowser;
