# Managed by ansible/kiosk.yaml — do not edit on the node.
[Unit]
Description=DeskPi rack touchscreen kiosk (browser via sway)
After=seatd.service systemd-user-sessions.service network-online.target
Wants=seatd.service network-online.target

[Service]
User=kiosk
Group=kiosk
SupplementaryGroups=video render input
StandardOutput=journal
StandardError=journal

# No TTYPath/StandardInput=tty/PAMName: claiming a VT is the logind route to a
# seat and fails as a non-root user (exit 208/STDIN). seatd supplies DRM master
# and input with no controlling terminal; /run/seatd.sock is root:video.
RuntimeDirectory=kiosk
StateDirectory=kiosk
Environment=XDG_RUNTIME_DIR=/run/kiosk
Environment=XDG_SEAT=seat0
# Skip libseat's logind probe — there is no logind session to find.
Environment=LIBSEAT_BACKEND=seatd

# No WLR_BACKENDS: naming any backend replaces wlroots' autodetection instead of
# narrowing it, and `drm` alone yields a display with no input devices.
# Autodetection picks DRM + libinput.

# -c means /etc/sway/config is never read, so sway.conf is the entire config and
# the kiosk has no default keybindings.
# With session restore at its default, Epiphany reopens every tab of the previous
# run and appends the command-line URL, so each restart adds one more copy of the
# dashboard and its memory. Dropping the session file makes every start a single
# tab. rm -f cannot fail the unit the way a lockdown gsetting can.
ExecStartPre=/usr/bin/rm -f /var/lib/kiosk/.local/share/epiphany/session_state.xml /var/lib/kiosk/.local/share/epiphany/session_state.xml~
ExecStart=/usr/bin/sway -c /etc/kiosk/sway.conf
Restart=always
RestartSec=5

# Sandbox: a leaking/crashing browser must not disturb the k3s workloads sharing
# this node. They run in their own cgroups, unaffected by these limits.
MemoryAccounting=yes
MemoryMax=768M
CPUQuota=60%
TasksMax=400
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/kiosk /run/kiosk
# Subsystem specs, not paths: a DeviceAllow naming a directory like /dev/input
# is accepted then ignored, while still flipping DevicePolicy=auto into closed.
DeviceAllow=char-drm rw
DeviceAllow=char-input rw

[Install]
WantedBy=multi-user.target
