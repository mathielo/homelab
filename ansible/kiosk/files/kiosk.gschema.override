# Managed by ansible/kiosk.yaml — do not edit on the node.
[org.gnome.Epiphany]
# Epiphany otherwise opens a "make this the default browser?" dialog over the
# dashboard, which a panel with no keyboard cannot answer. Overriding the
# shipped default rather than writing per-user dconf survives a wiped profile.
ask-for-default=false

# Session restore is left at its default. 'crashed' looks like the right value —
# it stops tabs accumulating — but it writes an empty session_state.xml and then
# restores *that* after any abnormal exit, producing no window, which reads as
# another crash. The loop is self-sustaining and survives reverting the setting;
# only deleting the profile clears it. kiosk.service drops the session file at
# start instead, which gets the same single tab with no way to wedge.
