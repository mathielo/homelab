#!/usr/bin/env bash
# Managed by ansible/kiosk.yaml — do not edit on the node.
# sway execs this from sway.conf; it inherits WAYLAND_DISPLAY and SWAYSOCK.
set -euo pipefail

# Keep WebKit off the GPU: software compositing is free at 1280x400, and the
# kiosk then holds no render contexts on a node running cluster workloads.
export WEBKIT_DISABLE_COMPOSITING_MODE=1
export WEBKIT_DISABLE_DMABUF_RENDERER=1

# --kiosk-mode removes the browser chrome, and must be the ONLY mode flag:
# ephy-main.c picks the shell mode from an if/else-if chain where kiosk-mode is
# last, so --application-mode or --profile silently wins and the chrome returns.
# HOME is /var/lib/kiosk, so the default profile is already private to this user.
#
# Absolute path because systemd's default PATH has no /snap/bin. dbus-run-session
# because Epiphany needs a session bus and there is no logind session to give it.
dbus-run-session -- /usr/bin/epiphany --kiosk-mode "{{ kiosk_url }}" || true

# sway does not exit when its client does; without this a dead browser leaves a
# black screen with the unit still active, so Restart=always never fires.
swaymsg exit
