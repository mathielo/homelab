# Managed by Ansible — Pi-hole VRRP failover.
# IPv4 (.53) and IPv6 (::53) VIPs are kept in one sync group so they always fail
# over together — never split across nodes. chk_pihole has no weight, so on
# failure the active node enters FAULT and releases both VIPs; the standby claims
# them within a couple seconds. The master preempts back on recovery.
# IPv6 requires VRRPv3 (which has no authentication); IPv4 stays VRRPv2 + PASS.

vrrp_script chk_pihole {
    script "/usr/local/bin/chk_pihole"
    interval 2
    timeout 3
    fall 2
    rise 2
}

vrrp_sync_group PIHOLE {
    group {
        PIHOLE_V4
        PIHOLE_V6
    }
}

vrrp_instance PIHOLE_V4 {
    state {{ keepalived_state }}
    interface {{ pihole_interface }}
    virtual_router_id 53
    priority {{ keepalived_priority }}
    advert_int 1
    authentication {
        auth_type PASS
        auth_pass {{ keepalived_auth_pass }}
    }
    virtual_ipaddress {
        {{ pihole_vip }}/24
    }
    track_script {
        chk_pihole
    }
}

vrrp_instance PIHOLE_V6 {
    state {{ keepalived_state }}
    interface {{ pihole_interface }}
    version 3
    virtual_router_id 63
    priority {{ keepalived_priority }}
    advert_int 1
    virtual_ipaddress {
        {{ pihole_vip6 }}/64
    }
    track_script {
        chk_pihole
    }
}
