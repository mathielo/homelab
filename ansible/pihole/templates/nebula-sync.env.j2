# Managed by Ansible. PRIMARY is this box (pihole-01) over loopback; REPLICAS is
# pihole-02. Plaintext HTTP stays within VLAN 53. Auth uses the admin web
# password (pihole_password, set on both nodes by Ansible) — the v6 API accepts
# it directly, so no app password / app_sudo is needed. nebula-sync schedules
# itself via CRON.
PRIMARY=http://127.0.0.1|{{ pihole_password }}
REPLICAS=http://10.10.53.52|{{ pihole_password }}
FULL_SYNC=true
# RUN_GRAVITY is off because a gravity rebuild's SD I/O hangs FTL on the 1 GB
# RPi3 standby, and the import already restarts FTL once — hourly is too often.
# The cost: teleporter replicates the adlist rows (including their `number`
# counts, so the UI looks right) but NOT the `gravity` table those counts refer
# to. The replica therefore only ever holds the lists it fetched itself, and
# needs a one-off `sudo pihole -g` after a rebuild or an adlist change — see
# "Rebuilding a node" in ansible/pihole.md.
RUN_GRAVITY=false
CRON={{ nebula_sync_cron }}
