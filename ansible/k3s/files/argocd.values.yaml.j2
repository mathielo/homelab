global:
  domain: argocd.hl.mathielo.com

configs:
  params:
    # TLS is terminated at the NGINX ingress level; ArgoCD itself runs plain HTTP.
    server.insecure: "true"
  cm:
    # Allow helm-secrets URL schemes in valueFiles references.
    helm.valuesFileSchemes: >-
      secrets+age-import, secrets+age-import-kubernetes,
      secrets, secrets+literal, https
    # Read-only account for Homepage widget integration.
    accounts.homepage: apiKey
  rbac:
    policy.csv: |
      p, role:readonly, applications, get, */*, allow
      g, homepage, role:readonly
  secret:
    # Bcrypt hash of the ArgoCD admin password.
    # Stored encrypted in secrets.sops.yaml as argocd_admin_password_hash.
    argocdServerAdminPassword: "{{ argocd_admin_password_hash }}"

server:
  ingress:
    enabled: true
    ingressClassName: nginx
    hostname: argocd.hl.mathielo.com
    tls: true
    annotations:
      cert-manager.io/cluster-issuer: letsencrypt-prod
      nginx.ingress.kubernetes.io/backend-protocol: HTTP

  resources:
    requests:
      cpu: 50m
      memory: 128Mi
    limits:
      cpu: 500m
      memory: 512Mi

applicationSet:
  resources:
    requests:
      cpu: 10m
      memory: 64Mi
    limits:
      cpu: 100m
      memory: 128Mi

controller:
  resources:
    requests:
      cpu: 50m
      memory: 256Mi
    limits:
      cpu: 500m
      # ArgoCD controller can spike memory when all apps are syncing at once
      memory: 1Gi

repoServer:
  # helm-secrets plugin: decrypts values.sops.yaml files during Helm rendering.
  # The init container downloads helm-secrets + sops into an emptyDir shared with
  # the repo-server. The age private key is mounted from a k8s Secret created by
  # the argocd.yaml Ansible playbook.
  env:
    - name: HELM_PLUGINS
      value: /custom-tools/helm-plugins/
    - name: HELM_SECRETS_SOPS_PATH
      value: /custom-tools/sops
    - name: HELM_SECRETS_BACKEND
      value: sops
    - name: HELM_SECRETS_VALUES_ALLOW_SYMLINKS
      value: "false"
    - name: HELM_SECRETS_VALUES_ALLOW_ABSOLUTE_PATH
      value: "true"
    - name: HELM_SECRETS_VALUES_ALLOW_PATH_TRAVERSAL
      value: "false"
    - name: SOPS_AGE_KEY_FILE
      value: /sops-age/key.txt

  volumes:
    - name: custom-tools
      emptyDir: {}
    - name: sops-age
      secret:
        secretName: helm-secrets-private-keys

  volumeMounts:
    - name: custom-tools
      mountPath: /custom-tools
    - name: sops-age
      mountPath: /sops-age

  initContainers:
    - name: download-tools
      image: alpine:3.21
      imagePullPolicy: IfNotPresent
      command: [sh, -ec]
      args:
        - |
          mkdir -p /custom-tools/helm-plugins
          wget -qO- https://github.com/jkroepke/helm-secrets/releases/latest/download/helm-secrets.tar.gz \
            | tar -xzf- -C /custom-tools/helm-plugins
          wget -qO /custom-tools/sops https://github.com/getsops/sops/releases/download/v3.12.2/sops-v3.12.2.linux.amd64
          chmod +x /custom-tools/sops
      volumeMounts:
        - name: custom-tools
          mountPath: /custom-tools

  resources:
    requests:
      cpu: 10m
      memory: 64Mi
    limits:
      cpu: 200m
      memory: 512Mi

redis:
  resources:
    requests:
      cpu: 10m
      memory: 32Mi
    limits:
      cpu: 100m
      memory: 64Mi
