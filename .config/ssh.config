# ~/.ssh/config file template
# Either copy it or create a symlink to it in ~/.ssh/config:
#  - cp ~/src/homelab/.config/ssh.config ~/.ssh/config
#  - ln -sf ~/src/homelab/.config/ssh.config ~/.ssh/config

# Use the 1Password agent to authenticate with all hosts
Host *
  IdentityAgent ~/.1password/agent.sock

# Specify which key to use for GitHub authentication
Host github.com
  IdentityFile ~/.ssh/gh1p.pub
  IdentitiesOnly yes

###
### UniFi Devices
###
### Connections to all of them are passwordless, using the 1Password agent
###

# UGC Max (UniFi Router)
Host UGCMax
  Hostname 10.10.1.1
  User root

# UNVR Instant
Host UNVR
  Hostname 10.10.20.2
  User root

# UNAS 4
Host UNAS
  Hostname 10.10.50.4
  User root

# Any other UniFi devices
Host 10.10.1.*
  User kiRKqamZxM
  StrictHostKeyChecking no

###
### Homelab Servers
###
### These are all set up via Ansible with passwordless auth (SSH key only)
###

# Pi-hole (AdBlocker) — 10.10.53.53 is the floating VRRP VIP; use the per-host
# aliases below for direct access to each box.
Host pihole-01
  Hostname 10.10.53.51
  User m8hl

Host pihole-02
  Hostname 10.10.53.52
  User m8hl

# Home Assitant
Host homeassistant
  Hostname 10.10.50.123
  User root

# k3s Hosts
Host k3s-*
  User m8hl
Host k3s-server
  Hostname 10.10.50.10
Host k3s-node-01
  Hostname 10.10.50.11
Host k3s-node-02
  Hostname 10.10.50.12
