[Unit]
Description=SSHFS mount of k3s-node-02:/mnt/r0 at ~/mnt/node02-r0
# Auth goes through the 1Password agent socket, which only exists once the
# desktop app is up and unlocked — retry forever instead of giving up at boot.
StartLimitIntervalSec=0

[Service]
Type=exec
ExecStartPre=/usr/bin/mkdir -p %h/mnt/node02-r0
ExecStart=/usr/bin/sshfs -f -o reconnect,ServerAliveInterval=15,ServerAliveCountMax=3 k3s-node-02:/mnt/r0 %h/mnt/node02-r0
ExecStop=/usr/bin/fusermount3 -u %h/mnt/node02-r0
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
