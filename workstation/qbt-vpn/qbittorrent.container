[Unit]
Description=qBittorrent (network namespace shared with Gluetun)
# BindsTo: stop qBt the moment gluetun stops, so the killswitch is enforced
# at the systemd layer too — not only by the missing netns / gluetun firewall.
Requires=gluetun.service
BindsTo=gluetun.service
After=gluetun.service

[Container]
ContainerName=qbittorrent
Image=ghcr.io/hotio/qbittorrent:release-5.2.0

# Borrow gluetun's netns. qBt has no interfaces of its own — if gluetun dies,
# the netns disappears and qBt loses all connectivity. This is the killswitch.
Network=container:gluetun

# Custom userns map: bridge in-container UID/GID 1000 ('hotio') directly to
# host UID/GID 1000 (the login user) so files qBt writes are owned by the
# host user — no chown / ACL workarounds, no `:idmap` on volumes.
#
# In rootless podman the user's namespace has intermediate slot 0 = host UID
# 1000, slots 1+ = the user's sub-UID range. The map below sends:
#   container 0..999     → intermediate 1..1000 (sub-UID range)
#   container 1000       → intermediate 0       (= host UID 1000)
#   container 1001..end  → intermediate 1001..  (sub-UID range, continued)
# hotio's s6 init still starts as root in the container (sub-UID on disk,
# fine) and drops to PUID=1000, which lands on host UID 1000.
UIDMap=0:1:1000
UIDMap=1000:0:1
UIDMap=1001:1001:64535
GIDMap=0:1:1000
GIDMap=1000:0:1
GIDMap=1001:1001:64535

Volume=%h/.local/share/qbt-vpn/qbt-config:/config:Z
# Incomplete torrents (downloading) stay on the NVMe drive
Volume=%h/_qbt:/incomplete:Z
# Completed downloads move to the HDD RAID 0
Volume=/mnt/r0:/dl:Z

Environment=PUID=1000
Environment=PGID=1000
Environment=UMASK=002
Environment=TZ=Europe/Stockholm
Environment=WEBUI_PORTS=8080/tcp

[Service]
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=default.target
