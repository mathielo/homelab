[Unit]
Description=Gluetun VPN sidecar (ProtonVPN WireGuard) for qBittorrent
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=gluetun
Image=ghcr.io/qdm12/gluetun:v3.41.1

AddDevice=/dev/net/tun
AddCapability=NET_ADMIN

# qBittorrent shares this netns via Network=container:gluetun, so the WebUI
# is published from here. Bound to loopback only — use SSH/Tailscale for remote.
PublishPort=127.0.0.1:8080:8080

Volume=%h/.local/share/qbt-vpn/gluetun:/gluetun:Z
Volume=%h/.local/share/qbt-vpn/scripts:/scripts:Z,ro

EnvironmentFile=%h/.config/qbt-vpn/secrets.env

Environment=VPN_SERVICE_PROVIDER=protonvpn
Environment=VPN_TYPE=wireguard
Environment=SERVER_COUNTRIES=Sweden
Environment=SERVER_FEATURES=p2p
Environment=VPN_PORT_FORWARDING=on
Environment=PORT_FORWARD_ONLY=on
Environment=DNS_UPSTREAM_RESOLVERS=cloudflare,quad9
# Lets the UP_COMMAND script reach qBt at 127.0.0.1:8080 inside this netns.
Environment=FIREWALL_OUTBOUND_SUBNETS=127.0.0.1/32
# Allows host → qBt WebUI through the published port (gluetun's firewall
# would drop it otherwise).
Environment=FIREWALL_INPUT_PORTS=8080

Environment=VPN_PORT_FORWARDING_UP_COMMAND=/scripts/update-qbt-port.sh

HealthCmd=/gluetun-entrypoint healthcheck
HealthInterval=30s
HealthStartPeriod=30s
HealthRetries=3

[Service]
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=default.target
