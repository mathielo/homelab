# Homelab MCP Server Configuration
# https://github.com/bjeans/homelab-mcp/blob/main/.env.example

# Pi-hole Configuration
# Get API key from: Pi-hole Admin > Settings > API > Show API token
PIHOLE_SERVER1_HOST=192.168.10.9
PIHOLE_API_KEY_SERVER1=

# UniFi Configuration
# Get API key from: UniFi Console > Settings > Admins & Users > API
UNIFI_HOST=192.168.1.1
UNIFI_API_KEY=
