#!/usr/bin/env bash
#
# Gracefully shuts down all devices on the homelab rack.
# Uses SSH hosts defined in ~/.ssh/config (sourced from .config/ssh.config).
#
# Shutdown order:
#   1. Home Assistant Pi (fire and forget)
#   2. Detach Longhorn volumes (cordon + scale workloads to 0 + wait)
#   3. Stop the DAS array on k3s-node-02
#   4. Shut down k3s nodes (agents first, then server)
#   5. pihole-01 (last — it's DNS for everything)
#
# Step 2 is critical: powering off a node while a Longhorn volume is still
# attached tears the iSCSI session away mid-write and corrupts the ext4/DB on
# it (see docs/storage-longhorn.md). Detaching first makes poweroff safe.
# Reverse with scripts/rack/startup, which uncordons the nodes.
#
# Follows Longhorn's official node-maintenance procedure (cordon first):
#   https://documentation.suse.com/cloudnative/storage/1.10/en/troubleshooting-maintenance/maintenance.html
# We scale workloads to 0 rather than `kubectl drain` because a full-rack drain
# deadlocks on the last replica (Node Drain Policy: Block If Contains Last Replica).
#
# Cordoning before scaling is also what makes this safe against ArgoCD selfHeal:
# a deployment Argo scales back to 1 lands on a cordoned node and stays Pending,
# so the volume it wanted stays detached.
#
# Usage: ./scripts/rack/shutdown

source "$(dirname "${BASH_SOURCE[0]}")/common.sh"

# Namespaces whose Longhorn-backed workloads must be drained before poweroff.
# Every namespace holding a Longhorn PVC belongs here — one that is missing gets
# its volume torn down with the node still attached. Cross-check with:
#   kubectl -n longhorn-system get volumes.longhorn.io \
#     -o jsonpath='{range .items[*]}{.status.kubernetesStatus.namespace}{"\n"}{end}' | sort -u
LONGHORN_NS=("media" "dashboard" "monitoring" "tools")

# k3s nodes in shutdown order: agents first, then server.
K3S_NODES=("${K3S_AGENTS[@]}" "$K3S_SERVER")

# Label selector for a StatefulSet's pods.
sts_selector() {
    kubectl -n "$1" get "$2" \
        -o go-template='{{range $k, $v := .spec.selector.matchLabels}}{{$k}}={{$v}},{{end}}' \
        | sed 's/,$//'
}

# A host counts as off only once it stops answering ICMP. sshd dies early in the
# shutdown sequence, so a refused SSH connection means "not accepting logins",
# not "powered off" — the machine is still unmounting filesystems for a while
# after that. Two consecutive lost pings are required so a single dropped packet
# does not read as a poweroff. Returns non-zero if the host never goes quiet.
wait_for_shutdown() {
    local host="$1"
    local addr
    addr=$(ssh -G "$host" 2>/dev/null | awk '/^hostname /{print $2; exit}')
    local max_wait=180
    local elapsed=0
    log "Waiting for $host ($addr) to stop responding to ping..."
    while [ $elapsed -lt $max_wait ]; do
        if ! ping -c2 -W1 "$addr" >/dev/null 2>&1; then
            log "$host is offline."
            return 0
        fi
        sleep 3
        elapsed=$((elapsed + 3))
    done
    warn "$host still answering ping after ${max_wait}s — NOT confirmed powered off."
    return 1
}

# --- Step 1: Home Assistant Pi (fire and forget) ---

log "=== Step 1: Shutting down Home Assistant ==="
run_ssh homeassistant "sudo shutdown -h now" || warn "Failed to send shutdown to homeassistant"

# --- Step 2: Detach Longhorn volumes ---
# Cordon so nothing reschedules, scale workloads to 0 so every Longhorn volume
# detaches, then wait for confirmation before any node loses power.

log "=== Step 2: Detaching Longhorn volumes ==="

for node in "${K3S_NODES[@]}"; do
    kubectl cordon "$node" || warn "Failed to cordon $node"
done

for ns in "${LONGHORN_NS[@]}"; do
    log "Draining $ns..."
    kubectl -n "$ns" scale deployment --all --replicas=0 || warn "Failed to scale down deployments in $ns"

    # StatefulSets with `whenScaled: Delete` destroy their PVC when scaled to 0
    # (docs/pvc-maintenance.md) — monitoring/loki lost storage-loki-0 that way.
    # Deleting the pod releases the volume just as well, and the cordon above
    # keeps the replacement Pending.
    for sts in $(kubectl -n "$ns" get sts -o name); do
        if [ "$(kubectl -n "$ns" get "$sts" -o jsonpath='{.spec.persistentVolumeClaimRetentionPolicy.whenScaled}')" = "Delete" ]; then
            log "$ns/$sts is whenScaled=Delete — deleting its pods instead of scaling."
            kubectl -n "$ns" delete pod -l "$(sts_selector "$ns" "$sts")" \
                || warn "Failed to delete pods for $ns/$sts"
        else
            kubectl -n "$ns" scale "$sts" --replicas=0 || warn "Failed to scale down $ns/$sts"
        fi
    done
done

log "Waiting for all Longhorn volumes to detach..."
elapsed=0
max_wait=180
while [ $elapsed -lt $max_wait ]; do
    attached=$(kubectl -n longhorn-system get volumes.longhorn.io \
        -o jsonpath='{range .items[*]}{.metadata.name}={.status.state}{"\n"}{end}' \
        | grep -v '=detached$' || true)
    if [ -z "$attached" ]; then
        log "All Longhorn volumes detached."
        break
    fi
    sleep 5
    elapsed=$((elapsed + 5))
done
if [ -n "$attached" ]; then
    warn "Volumes still attached after ${max_wait}s — NOT safe to power off:"
    echo "$attached" >&2
    warn "Powering off now risks corrupting them."
    read -r -p "Type 'yes' to power off anyway, anything else aborts: " reply
    [ "$reply" = "yes" ] || { warn "Aborted — nothing was powered off."; exit 1; }
fi

# --- Step 3: Stop the DAS array on k3s-node-02 ---
# The enclosure loses power with the rack. Its RAID 0 has no backup, so the array
# is stopped explicitly rather than left to systemd's unmount on the way down.
# See docs/das-power-cycle.md. Never run ansible/das-raid.yaml to bring it back.

log "=== Step 3: Stopping the DAS array on k3s-node-02 ==="
if run_ssh k3s-node-02 "sudo das-down"; then
    run_ssh k3s-node-02 "cat /proc/mdstat; mountpoint /mnt/r0 || echo 'unmounted OK'" || true
else
    warn "das-down FAILED — the array is likely still assembled and mounted:"
    run_ssh k3s-node-02 "cat /proc/mdstat; mountpoint /mnt/r0" >&2 || true
    warn "This is RAID 0 with no backup. Work through the mount-namespace holder"
    warn "checks in docs/das-power-cycle.md before continuing."
    read -r -p "Type 'yes' to power off anyway, anything else aborts: " reply
    [ "$reply" = "yes" ] || { warn "Aborted — nothing was powered off."; exit 1; }
fi

# --- Step 4: Shut down k3s nodes ---
# Hosts that never stopped answering ping are collected so the final message can
# distinguish "all down" from "we asked them to go down".
not_confirmed=()

log "=== Step 4: Shutting down k3s nodes ==="
for node in "${K3S_NODES[@]}"; do
    log "Shutting down $node..."
    run_ssh "$node" "sudo shutdown -h now" || warn "Failed to send shutdown to $node"
    wait_for_shutdown "$node" || not_confirmed+=("$node")
done

# --- Step 5: pihole-01 (last — DNS for the whole network) ---
# Only pihole-01 is rack-mounted. pihole-02 stays up and keepalived hands it the
# VIP, so the network keeps resolving DNS while the rack is down.

log "=== Step 5: Shutting down pihole-01 ==="
run_ssh pihole-01 "sudo shutdown -h now" || warn "Failed to send shutdown to pihole-01"
wait_for_shutdown pihole-01 || not_confirmed+=("pihole-01")

log "Checking pihole-02 took over the VIP..."
if run_ssh pihole-02 "ip -4 addr show eth0 | grep -q 10.10.53.53"; then
    log "pihole-02 holds 10.10.53.53 — DNS is up."
else
    warn "pihole-02 does NOT hold 10.10.53.53 — the network has no DNS. Investigate before walking away."
fi

log "=== Rack shutdown complete ==="
if [ ${#not_confirmed[@]} -gt 0 ]; then
    warn "NOT confirmed powered off: ${not_confirmed[*]}"
    warn "Do not disconnect power until these stop answering ping."
    exit 1
fi
log "All hosts confirmed powered off."
log "Safe to disconnect power. Power the DAS enclosure off at its own switch first."
