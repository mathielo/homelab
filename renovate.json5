{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'docker:enableMajor',
    ':disableRateLimiting',
  ],
  schedule: [
    'after 10am and before 6pm on Saturday and Sunday',
  ],
  timezone: 'Europe/Stockholm',
  ignorePaths: [
    '**/*.sops.yaml',
    '.sops.yaml',
  ],
  dependencyDashboard: true,
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/ansible/k3s/files/.*\\.j2$/',
      ],
      matchStrings: [
        'github\\.com/getsops/sops/releases/download/(?<currentValue>v[\\d.]+)/sops-',
      ],
      depNameTemplate: 'getsops/sops',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/ansible/k3s/files/.*\\.j2$/',
      ],
      matchStrings: [
        'image:\\s*(?<depName>alpine):(?<currentValue>[\\w.]+)',
      ],
      datasourceTemplate: 'docker',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/ansible/k3s/argocd\\.yaml$/',
      ],
      matchStrings: [
        'helm upgrade --install argocd argo/argo-cd[\\s\\S]*?--version\\s+(?<currentValue>[\\d.]+)',
      ],
      depNameTemplate: 'argo-cd',
      datasourceTemplate: 'helm',
      registryUrlTemplate: 'https://argoproj.github.io/argo-helm',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/ansible/k3s/cert-manager\\.yaml$/',
      ],
      matchStrings: [
        'helm upgrade --install cert-manager jetstack/cert-manager[\\s\\S]*?--version\\s+(?<currentValue>[v\\d.]+)',
      ],
      depNameTemplate: 'cert-manager',
      datasourceTemplate: 'helm',
      registryUrlTemplate: 'https://charts.jetstack.io',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/ansible/k3s/install-k3s\\.yaml$/',
      ],
      matchStrings: [
        'helm upgrade --install ingress-nginx\\s+ingress-nginx/ingress-nginx[\\s\\S]*?--version\\s+(?<currentValue>[\\d.]+)',
      ],
      depNameTemplate: 'ingress-nginx',
      datasourceTemplate: 'helm',
      registryUrlTemplate: 'https://kubernetes.github.io/ingress-nginx',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/ansible/group_vars/all/k3s\\.yml$/',
      ],
      matchStrings: [
        'k3s_version:\\s*"(?<currentValue>v[\\d.]+\\+k3s\\d+)"',
      ],
      depNameTemplate: 'k3s-io/k3s',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/ansible/k3s/monitoring\\.yaml$/',
      ],
      matchStrings: [
        'helm upgrade --install prometheus\\s+prometheus-community/prometheus[\\s\\S]*?--version\\s+(?<currentValue>[\\d.]+)',
      ],
      depNameTemplate: 'prometheus',
      datasourceTemplate: 'helm',
      registryUrlTemplate: 'https://prometheus-community.github.io/helm-charts',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/ansible/k3s/monitoring\\.yaml$/',
      ],
      matchStrings: [
        'helm upgrade --install loki\\s+grafana/loki[\\s\\S]*?--version\\s+(?<currentValue>[\\d.]+)',
      ],
      depNameTemplate: 'loki',
      datasourceTemplate: 'helm',
      registryUrlTemplate: 'https://grafana.github.io/helm-charts',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/ansible/k3s/monitoring\\.yaml$/',
      ],
      matchStrings: [
        'helm upgrade --install promtail\\s+grafana/promtail[\\s\\S]*?--version\\s+(?<currentValue>[\\d.]+)',
      ],
      depNameTemplate: 'promtail',
      datasourceTemplate: 'helm',
      registryUrlTemplate: 'https://grafana.github.io/helm-charts',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/ansible/k3s/monitoring\\.yaml$/',
      ],
      matchStrings: [
        'helm upgrade --install grafana\\s+grafana/grafana[\\s\\S]*?--version\\s+(?<currentValue>[\\d.]+)',
      ],
      depNameTemplate: 'grafana',
      datasourceTemplate: 'helm',
      registryUrlTemplate: 'https://grafana.github.io/helm-charts',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/ansible/k3s/longhorn\\.yaml$/',
      ],
      matchStrings: [
        'helm upgrade --install longhorn\\s+longhorn/longhorn[\\s\\S]*?--version\\s+(?<currentValue>[\\d.]+)',
      ],
      depNameTemplate: 'longhorn',
      datasourceTemplate: 'helm',
      registryUrlTemplate: 'https://charts.longhorn.io',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/ansible/glances\\.yaml$/',
      ],
      matchStrings: [
        'uv tool install glances==(?<currentValue>[\\d.]+)',
      ],
      depNameTemplate: 'glances',
      datasourceTemplate: 'pypi',
    },
  ],
  packageRules: [
    {
      description: 'Hotio media stack images (excl. Plex)',
      matchDatasources: [
        'docker',
      ],
      versioning: 'regex:^release-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(\\.(?<build>\\d+))?(-(?<revision>\\d+))?$',
      groupName: 'media-stack-hotio',
      matchPackageNames: [
        '/^ghcr\\.io/hotio//',
        '!ghcr.io/hotio/plex',
      ],
    },
    {
      description: 'Plex has a hex commit hash suffix: release-1.2.3.4567-abc123f',
      matchDatasources: [
        'docker',
      ],
      versioning: 'regex:^release-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)-[0-9a-f]+$',
      groupName: 'media-stack-hotio',
      matchPackageNames: [
        'ghcr.io/hotio/plex',
      ],
    },
    {
      description: 'Media support (Gluetun, busybox)',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/qdm12/gluetun',
        'busybox',
      ],
      groupName: 'media-support',
    },
    {
      description: 'Media bots (Searcharr, Pulsarr)',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'toddrob99/searcharr',
        'lakker/pulsarr',
        'ghcr.io/autobrr/autobrr',
        'ghcr.io/autobrr/qui',
      ],
      groupName: 'media-bots',
    },
    {
      description: 'Dashboard images',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/gethomepage/homepage',
        'louislam/uptime-kuma',
        'ghcr.io/bigboot/autokuma',
      ],
      groupName: 'dashboard',
    },
    {
      description: 'bjw-s app-template',
      matchDatasources: [
        'helm',
      ],
      matchPackageNames: [
        'app-template',
      ],
      groupName: 'helm-app-template',
    },
    {
      description: 'Cluster infra charts + SOPS',
      matchDatasources: [
        'helm',
        'github-releases',
      ],
      matchPackageNames: [
        'argo-cd',
        'cert-manager',
        'ingress-nginx',
        'longhorn',
        'getsops/sops',
      ],
      groupName: 'cluster-infra',
    },
    {
      description: 'Monitoring stack charts',
      matchDatasources: [
        'helm',
      ],
      matchPackageNames: [
        'prometheus',
        'loki',
        'promtail',
        'grafana',
      ],
      groupName: 'monitoring-infra',
    },
    {
      matchUpdateTypes: [
        'major',
      ],
      dependencyDashboardApproval: true,
      labels: [
        'major-update',
      ],
    },
  ],
}
