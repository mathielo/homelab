{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'docker:enableMajor',
    ':disableRateLimiting',
  ],
  schedule: [
    'after 10am and before 6pm on Saturday and Sunday',
  ],
  timezone: 'Europe/Stockholm',
  ignorePaths: [
    '**/*.sops.yaml',
    '.sops.yaml',
  ],
  dependencyDashboard: true,
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/ansible/k3s/files/.*\\.j2$/',
      ],
      matchStrings: [
        'SOPS=(?<currentValue>v[\\d.]+)',
      ],
      depNameTemplate: 'getsops/sops',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/ansible/k3s/files/.*\\.j2$/',
      ],
      matchStrings: [
        'image:\\s*(?<depName>alpine):(?<currentValue>[\\w.]+)',
      ],
      datasourceTemplate: 'docker',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/ansible/k3s/argocd\\.yaml$/',
      ],
      matchStrings: [
        'helm upgrade --install argocd argo/argo-cd[\\s\\S]*?--version\\s+(?<currentValue>[\\d.]+)',
      ],
      depNameTemplate: 'argo-cd',
      datasourceTemplate: 'helm',
      registryUrlTemplate: 'https://argoproj.github.io/argo-helm',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/ansible/k3s/cert-manager\\.yaml$/',
      ],
      matchStrings: [
        'helm upgrade --install cert-manager jetstack/cert-manager[\\s\\S]*?--version\\s+(?<currentValue>[v\\d.]+)',
      ],
      depNameTemplate: 'cert-manager',
      datasourceTemplate: 'helm',
      registryUrlTemplate: 'https://charts.jetstack.io',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/ansible/k3s/install-k3s\\.yaml$/',
      ],
      matchStrings: [
        'helm upgrade --install ingress-nginx\\s+ingress-nginx/ingress-nginx[\\s\\S]*?--version\\s+(?<currentValue>[\\d.]+)',
      ],
      depNameTemplate: 'ingress-nginx',
      datasourceTemplate: 'helm',
      registryUrlTemplate: 'https://kubernetes.github.io/ingress-nginx',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/ansible/group_vars/all/k3s\\.yml$/',
      ],
      matchStrings: [
        'k3s_version:\\s*"(?<currentValue>v[\\d.]+\\+k3s\\d+)"',
      ],
      depNameTemplate: 'k3s-io/k3s',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/ansible/k3s/longhorn\\.yaml$/',
      ],
      matchStrings: [
        'helm upgrade --install longhorn\\s+longhorn/longhorn[\\s\\S]*?--version\\s+(?<currentValue>[\\d.]+)',
      ],
      depNameTemplate: 'longhorn',
      datasourceTemplate: 'helm',
      registryUrlTemplate: 'https://charts.longhorn.io',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/ansible/k3s/metallb\\.yaml$/',
      ],
      matchStrings: [
        'helm upgrade --install metallb\\s+metallb/metallb[\\s\\S]*?--version\\s+(?<currentValue>[\\d.]+)',
      ],
      depNameTemplate: 'metallb',
      datasourceTemplate: 'helm',
      registryUrlTemplate: 'https://metallb.github.io/metallb',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/ansible/glances\\.yaml$/',
      ],
      matchStrings: [
        'uv tool install glances==(?<currentValue>[\\d.]+)',
      ],
      depNameTemplate: 'glances',
      datasourceTemplate: 'pypi',
    },
  ],
  // Also pick up split values files (e.g. values-common.yaml, values-br.yaml)
  // alongside the default values.yaml — qbt-* instances keep their image pins
  // in values-common.yaml so they were otherwise invisible to Renovate.
  'helm-values': {
    managerFilePatterns: [
      '/(^|/)values(-[a-z]+)?\\.ya?ml$/',
    ],
  },
  // Enable kubernetes manager only for shared infra manifests (GPU device
  // plugins, etc.) — bare image: pins in DaemonSet/Deployment YAMLs aren't
  // detected by helm-values.
  kubernetes: {
    managerFilePatterns: [
      '/k3s/apps/.*/_infra/.*\\.ya?ml$/',
    ],
  },
  packageRules: [
    {
      description: 'Hotio media stack images (excl. Plex)',
      matchDatasources: [
        'docker',
      ],
      versioning: 'regex:^release-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(\\.(?<build>\\d+))?(-(?<revision>\\d+))?$',
      groupName: 'media-stack-hotio',
      matchPackageNames: [
        '/^ghcr\\.io/hotio//',
        '!ghcr.io/hotio/plex',
      ],
    },
    {
      description: 'Plex has a hex commit hash suffix: release-1.2.3.4567-abc123f',
      matchDatasources: [
        'docker',
      ],
      versioning: 'regex:^release-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)-[0-9a-f]+$',
      groupName: 'media-stack-hotio',
      matchPackageNames: [
        'ghcr.io/hotio/plex',
      ],
    },
    {
      description: 'Media support (Gluetun, busybox, curl)',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/qdm12/gluetun',
        'busybox',
        'curlimages/curl',
      ],
      groupName: 'media-support',
    },
    {
      description: 'GPU device plugins',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'rocm/k8s-device-plugin',
        'intel/intel-gpu-plugin',
      ],
      groupName: 'gpu-plugins',
    },
    {
      description: 'Media bots (Searcharr, Pulsarr)',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'toddrob99/searcharr',
        'lakker/pulsarr',
        'ghcr.io/autobrr/autobrr',
        'ghcr.io/autobrr/qui',
        'ghcr.io/dictionarry-hub/profilarr',
        'ghcr.io/dictionarry-hub/profilarr-parser',
      ],
      groupName: 'media-bots',
    },
    {
      description: 'Dashboard images',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/gethomepage/homepage',
        'louislam/uptime-kuma',
        'ghcr.io/bigboot/autokuma',
        'ghcr.io/mathielo/homelab-kiosk',
      ],
      groupName: 'dashboard',
    },
    {
      description: 'bjw-s app-template',
      matchDatasources: [
        'helm',
      ],
      matchPackageNames: [
        'app-template',
      ],
      groupName: 'helm-app-template',
    },
    {
      description: 'Cluster infra charts + SOPS',
      matchDatasources: [
        'helm',
        'github-releases',
      ],
      matchPackageNames: [
        'argo-cd',
        'cert-manager',
        'ingress-nginx',
        'longhorn',
        'getsops/sops',
      ],
      groupName: 'cluster-infra',
    },
    {
      description: 'Monitoring stack charts',
      matchDatasources: [
        'helm',
      ],
      matchPackageNames: [
        'prometheus',
        'loki',
        'promtail',
        'grafana',
      ],
      groupName: 'monitoring-infra',
    },
    {
      matchUpdateTypes: [
        'major',
      ],
      dependencyDashboardApproval: true,
      labels: [
        'major-update',
      ],
    },
  ],
}
